{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: run api",
      "type": "shell",
      "command": "dotnet run --project src/SaaSProjectManager.API --urls http://localhost:5000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "fullstack",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "frontend: run web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend/saas-project-manager-web"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "fullstack",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "fullstack: run both",
      "dependsOn": ["backend: run api", "frontend: run web"],
      "dependsOrder": "parallel"
    }
  ]
}
